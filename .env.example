# Provider credentials — only needed for REAL providers.
# The mock provider (`--provider mock`) needs none of these.
# Export these in your shell (the pipeline reads os.environ, it does not
# auto-load this file):
#
#   export OPENAI_API_KEY="sk-..."

# OpenAI-compatible Chat Completions endpoint
OPENAI_API_KEY=
# Override for Azure/OpenRouter/other compatible gateways (optional)
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama server (optional; default shown)
OLLAMA_HOST=http://localhost:11434
