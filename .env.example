# .env.example — ARC Solver Evaluation Platform
#
# The pipeline reads os.environ only; it does NOT auto-load this file.
# Copy what you need and export it in your shell, e.g.:
#
#     export ATLAS_SOLVER=mock-baseline
#     export ANTHROPIC_API_KEY="sk-ant-..."
#
# Precedence (src/config.py):
#     CLI flag  >  ATLAS_* variable  >  built-in default
# For credentials/endpoints, the provider-specific variable wins over the
# generic ATLAS_* one. Mock solvers need NONE of this.

# ---- Pipeline defaults (all optional; flags override) ----------------------
# Registry solver when --solver is omitted (see: python src/run_evaluation.py --list-solvers)
ATLAS_SOLVER=
# LLM execution backend for ad-hoc --provider runs: mock | openai | gemini | claude | ollama
ATLAS_PROVIDER=mock
# Model name for ad-hoc LLM-direct runs (e.g. baseline, gpt-4o-mini, gemini-2.5-flash)
ATLAS_MODEL=
# Experiment label stamped on every result row (default: dev). When set, it
# also becomes build_analytics' default --experiment-id filter.
ATLAS_EXPERIMENT_ID=
# Prompt registry entry for LLM-direct (default: arc_grid_v1; use arc_grid_v2 for stricter grid-only)
ATLAS_PROMPT_VERSION=
# LLM-direct samples per item (default 1 = pass@1; ARC-style pass@2 → 2)
ATLAS_ATTEMPTS=
# Tasks-Parquet directory (default: data/parquet/evaluation)
ATLAS_INPUT_PATH=
# Root of the derived-data tree (default: data/parquet). Prefer absolute paths.
ATLAS_OUTPUT_ROOT=
# Registered benchmark pack id (e.g. arc_agi_2, example_local_pack)
ATLAS_BENCHMARK_PACK=

# ---- Generic LLM backend settings ------------------------------------------
ATLAS_API_KEY=
ATLAS_BASE_URL=
ATLAS_TIMEOUT_S=
ATLAS_MAX_OUTPUT_TOKENS=

# ---- OpenAI-compatible (--provider openai) ---------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_S=

# ---- Google Gemini (--provider gemini) -------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ---- Anthropic Claude (--provider claude) ----------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Local Ollama (--provider ollama) --------------------------------------
OLLAMA_HOST=http://localhost:11434
