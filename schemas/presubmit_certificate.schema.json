{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.local/schemas/presubmit_certificate.schema.json",
  "title": "ATLAS pre-submit certificate payload",
  "description": "Structured fields used to render reports/presubmit_certificate_<solver>.md. The Markdown file is the human artifact; this schema documents the logical checks.",
  "type": "object",
  "additionalProperties": true,
  "required": ["solver_name", "verdict", "checks"],
  "properties": {
    "solver_name": { "type": "string" },
    "verdict": {
      "type": "string",
      "enum": ["GO", "GO WITH WARNINGS", "NO-GO"]
    },
    "kaggle_score": { "type": ["number", "null"] },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "detail"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "artifact_parses",
              "kaggle_grader",
              "holdout_discipline",
              "runtime_budget",
              "offline_viability",
              "variance"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["pass", "warn", "fail"]
          },
          "detail": { "type": "string" }
        }
      }
    },
    "certificate_path": { "type": "string" }
  }
}
